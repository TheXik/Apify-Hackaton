{
    "title": "Talent Scout - AI Candidate Finder",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "jobTitle": {
            "title": "Job Title",
            "type": "string",
            "description": "Title of the position you're hiring for",
            "editor": "textfield"
        },
        "jobDescription": {
            "title": "Job Description",
            "type": "string",
            "description": "Detailed description of the job, responsibilities, and requirements",
            "editor": "textarea"
        },
        "requiredSkills": {
            "title": "Required Skills",
            "type": "array",
            "description": "List of must-have skills for this position",
            "items": {
                "type": "string"
            },
            "editor": "stringList"
        },
        "niceToHave": {
            "title": "Nice to Have Skills",
            "type": "array",
            "description": "Optional skills that would be a bonus",
            "items": {
                "type": "string"
            },
            "editor": "stringList"
        },
        "location": {
            "title": "Location",
            "type": "string",
            "description": "Preferred location or 'Remote'",
            "editor": "textfield"
        },
        "experienceYears": {
            "title": "Minimum Experience (years)",
            "type": "integer",
            "description": "Minimum years of relevant experience",
            "default": 0,
            "minimum": 0
        },
        "candidates": {
            "title": "Candidates to Evaluate",
            "type": "array",
            "description": "List of candidate profiles to rank (for testing or manual input)",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "bio": {
                        "type": "string"
                    },
                    "skills": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "experience": {
                        "type": "string"
                    },
                    "profileUrls": {
                        "type": "object"
                    }
                }
            },
            "editor": "json"
        },
        "topK": {
            "title": "Top K Candidates",
            "type": "integer",
            "description": "Number of top candidates to return after ranking",
            "default": 10,
            "minimum": 1,
            "maximum": 100
        }
    },
    "required": [
        "jobTitle",
        "jobDescription"
    ]
}